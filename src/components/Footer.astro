---
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const homeLink = `${base}#home`;
const ansatzLink = `${base}#mein-ansatz`;
const angeboteLink = `${base}#angebote`;
const ueberMichLink = `${base}#ueber-mich`;
const b2bLink = `${base}#b2b`;
const einblickeLink = `${base}#einblicke`;
const kontaktLink = `${base}#kontakt`;
const impressumLink = `${base}impressum`;
const datenschutzLink = `${base}datenschutz`;
const currentYear = new Date().getFullYear();
---

<footer class="ql-footer">
  <div class="ql-footer__container">
    {/* Brand & Tagline */}
    <div class="ql-footer__brand-wrapper">
      <span class="ql-footer__brand">Dr. Stefanie Schinnerl</span>
      <span class="ql-footer__tagline">BUSINESS ✦ BODY ✦ MIND</span>
    </div>

    {/* Navigation Links */}
    <nav class="ql-footer__nav" aria-label="Footer Navigation">
      <ul class="ql-footer__links">
        <li><a href={homeLink}>Home</a></li>
        <li><a href={ansatzLink}>Mein Ansatz</a></li>
        <li><a href={angeboteLink}>Angebote</a></li>
        <li><a href={ueberMichLink}>Über mich</a></li>
        <li><a href={b2bLink}>B2B &amp; Keynotes</a></li>
        <li><a href={einblickeLink}>Einblicke</a></li>
        <li><a href={kontaktLink}>Kontakt</a></li>
      </ul>
    </nav>

    {/* Social Icons (Instagram & LinkedIn) */}
    <div class="ql-footer__socials">
      <a
        href="https://www.instagram.com/bystefanieschinnerl/"
        target="_blank"
        rel="noopener noreferrer"
        class="ql-footer__social-link"
        aria-label="Instagram von Dr. Stefanie Schinnerl"
        title="Instagram"
      >
        <svg
          class="ql-footer__social-icon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <a
        href="https://www.linkedin.com/in/stefanie-schinnerl"
        target="_blank"
        rel="noopener noreferrer"
        class="ql-footer__social-link"
        aria-label="LinkedIn von Dr. Stefanie Schinnerl"
        title="LinkedIn"
      >
        <svg
          class="ql-footer__social-icon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
    </div>

    {/* Divider */}
    <div class="ql-footer__divider"></div>

    {/* Bottom Bar: Copyright & Legal */}
    <div class="ql-footer__bottom">
      <span class="ql-footer__copy">
        © {currentYear} Dr. Stefanie Schinnerl · Alle Rechte vorbehalten.
      </span>
      <div class="ql-footer__legal">
        <a href={impressumLink} class="ql-footer__legal-link">Impressum</a>
        <span class="ql-footer__legal-separator">·</span>
        <a href={datenschutzLink} class="ql-footer__legal-link">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
