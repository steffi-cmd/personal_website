---
interface Props {
  images?: string[];
  variant?: 'default' | 'fill';
  basePath?: string;
}

const { images = [], variant = 'default', basePath = '' } = Astro.props;

const defaultImages = [
  '/img/steffi_professionell.jpg',
  '/img/IMG_4897.JPG',
  '/img/IMG_4898.JPG',
  '/img/IMG_7991.jpg',
];

const list = images.length > 0 ? images : defaultImages;

const resolveSrc = (src: string) => {
  if (!src) return '';
  if (src.startsWith('http://') || src.startsWith('https://')) return src;
  const cleanBase = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
  const cleanPath = src.startsWith('/') ? src : `/${src}`;
  if (cleanBase && cleanPath.startsWith(cleanBase)) return cleanPath;
  return `${cleanBase}${cleanPath}`;
};

const slides = list.map((src, id) => ({
  id,
  src: resolveSrc(src)
}));
---

<div 
  class={`ql-carousel ${variant === 'fill' ? 'ql-carousel--fill' : ''}`}
  data-total={slides.length}
>
  <!-- Main Large Image Area -->
  <div class="ql-carousel__main">
    {slides.map((slide, idx) => (
      <div 
        class={`ql-carousel__slide ${idx === 0 ? 'is-active' : ''}`} 
        data-slide-index={idx}
      >
        <img
          src={slide.src}
          alt={`Slide ${idx + 1}`}
          loading="lazy"
          decoding="async"
        />
      </div>
    ))}

    <!-- Navigation Arrows -->
    <div class="ql-carousel__arrows">
      <button 
        type="button" 
        class="ql-carousel__arrow ql-carousel__arrow--prev" 
        aria-label="Vorheriges Bild"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button 
        type="button" 
        class="ql-carousel__arrow ql-carousel__arrow--next" 
        aria-label="Nächstes Bild"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
    </div>
  </div>

  {variant !== 'fill' && (
    <>
      <!-- Pagination Dots -->
      <div class="ql-carousel__dots">
        {slides.map((_, idx) => (
          <button
            type="button"
            class={`ql-carousel__dot ${idx === 0 ? 'is-active' : ''}`}
            data-target-index={idx}
            aria-label={`Gehe zu Slide ${idx + 1}`}
          />
        ))}
      </div>

      <!-- Thumbnails -->
      <div class="ql-carousel__thumbnails">
        {slides.map((slide, idx) => (
          <button
            type="button"
            class={`ql-carousel__thumb ${idx === 0 ? 'is-active' : ''}`}
            data-target-index={idx}
            aria-label={`Vorschau für Bild ${idx + 1}`}
          >
            <img 
              src={slide.src} 
              alt={`Thumbnail ${idx + 1}`} 
              loading="lazy" 
              decoding="async" 
            />
          </button>
        ))}
      </div>
    </>
  )}
</div>

<style>
  .ql-carousel {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Main Slide Area */
  .ql-carousel__main {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    border-radius: 4px;
    background: #f0eeea;
  }

  .ql-carousel__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease, transform 1s ease;
    z-index: 1;
  }

  .ql-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1.02);
    z-index: 2;
  }

  .ql-carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Arrows */
  .ql-carousel__arrows {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    display: flex;
    gap: 0.5rem;
    z-index: 10;
  }

  .ql-carousel__arrow {
    background: rgba(43, 58, 74, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(6px);
  }

  .ql-carousel__arrow:hover {
    background: rgba(43, 58, 74, 0.75);
    border-color: var(--color-accent, #C5A880);
    transform: scale(1.08);
  }

  /* Dots */
  .ql-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: -0.5rem;
  }

  .ql-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #dcd9d4;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    padding: 0;
  }

  .ql-carousel__dot.is-active {
    background-color: var(--color-text, #2C2C2C);
    transform: scale(1.25);
  }

  /* Thumbnails */
  .ql-carousel__thumbnails {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .ql-carousel__thumb {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 80px;
    height: 80px;
    overflow: hidden;
    border-radius: 4px;
    position: relative;
    transition: transform 0.3s ease;
  }

  .ql-carousel__thumb:hover {
    transform: translateY(-4px);
  }

  .ql-carousel__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, filter 0.3s ease;
    opacity: 0.55;
    filter: grayscale(80%);
    display: block;
  }

  .ql-carousel__thumb.is-active img {
    opacity: 1;
    filter: grayscale(0%);
  }

  .ql-carousel__thumb.is-active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--color-accent, #C5A880);
  }

  /* Fill Variant for Quote Band */
  .ql-carousel--fill {
    max-width: none;
    height: 100%;
    margin: 0;
    gap: 0;
  }

  .ql-carousel--fill .ql-carousel__main {
    aspect-ratio: auto;
    height: 100%;
    min-height: 450px;
    border-radius: 0;
  }

  @media (max-width: 768px) {
    .ql-carousel__thumb {
      width: 60px;
      height: 60px;
    }

    .ql-carousel--fill .ql-carousel__main {
      min-height: 350px;
    }
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll('.ql-carousel').forEach((carousel) => {
      if (carousel.hasAttribute('data-ready')) return;
      carousel.setAttribute('data-ready', 'true');

      const slides = carousel.querySelectorAll('.ql-carousel__slide');
      const dots = carousel.querySelectorAll('.ql-carousel__dot');
      const thumbs = carousel.querySelectorAll('.ql-carousel__thumb');
      const prevBtn = carousel.querySelector('.ql-carousel__arrow--prev');
      const nextBtn = carousel.querySelector('.ql-carousel__arrow--next');
      const total = slides.length;
      let current = 0;

      function goTo(index: number) {
        current = (index + total) % total;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === current);
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === current);
        });
        thumbs.forEach((thumb, i) => {
          thumb.classList.toggle('is-active', i === current);
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          goTo(current - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          goTo(current + 1);
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = parseInt(dot.getAttribute('data-target-index') || '0', 10);
          goTo(target);
        });
      });

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = parseInt(thumb.getAttribute('data-target-index') || '0', 10);
          goTo(target);
        });
      });
    });
  }

  // Initialize immediately and on Astro page transitions
  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
