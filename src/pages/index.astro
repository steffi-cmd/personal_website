              <p class="ql-studio-card__desc">
                Du möchtest die Dynamik einer gemeinsamen Praxis erleben? Ich unterrichte regelmäßig wechselnde Klassen und Specials in ausgewählten Studios in Wien.
              </p>
            </div>

            <div class="ql-studio-card__columns">
              {/* Spalte 1: Feste Klassen & Turnsaal Women */}
              <div class="ql-studio-card__col ql-studio-card__col--left">
                <div class="ql-studio-card__col-content">
                  <span class="ql-studio-card__kicker">
                    Turnsaal Women • 1090 Wien
                  </span>
                  <h4 class="ql-studio-card__col-title">
                    Bodybalance
                  </h4>
                  <p class="ql-studio-card__desc">
                    Kräftigung, Haltung und tiefe Entspannung: Eine fließende Kombination aus Elementen von Yoga, Pilates und Barre für nachhaltige Vitalität.
                  </p>
                </div>
                <div class="ql-studio-card__col-actions">
                  <a
                    href="https://www.turnsaal-women.at"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ql-btn ql-btn--primary"
                  >
                    <span>Stundenplan &amp; Buchung</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>

              {/* Spalte 2: Specials & Instagram */}
              <div class="ql-studio-card__col">
                <div class="ql-studio-card__col-content">
                  <span class="ql-studio-card__kicker">
                    Specials &amp; Formate
                  </span>
                  <h4 class="ql-studio-card__col-title">
                    Specials &amp; Termine
                  </h4>
                  <p class="ql-studio-card__desc">
                    Neben festen Klassen unterrichte ich wechselnde Specials und Pop-up Einheiten in Wien.
                  </p>
                </div>
                <div class="ql-studio-card__col-actions">
                  <a
                    href="https://www.instagram.com/bystefanieschinnerl/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ql-btn ql-btn--outline"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                    <span>Wochenplan auf Instagram</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ④ ÜBER MICH & FUNDAMENT */}
    <section class="ql-about-voyage ql-reveal" id="ueber-mich">
      <div class="ql-about-voyage__container">
        {/* 1. STUFE: 3-Foto Collage (Links) & Story (Rechts) */}
        <div class="ql-about-voyage__stage">
          <div class="ql-about-voyage__photo-col ql-stagger">
            <div class="ql-about-voyage__moodboard ql-about-voyage__moodboard--duo">
              {/* Foto 1: Oben Links (0795 - Gemeinschaft, Energie & Lachen) */}
              <div class="ql-about-voyage__duo-card ql-about-voyage__duo-card--top-left">
                <img
                  src={resolveAsset('/img/A7R00795.jpg')}
                  alt="Dr. Stefanie Schinnerl: Energie, Bewegung und Verbundenheit"
                  class="ql-about-voyage__duo-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              {/* Foto 2: Unten Rechts (1304 - Business & Klarheit) */}
              <div class="ql-about-voyage__duo-card ql-about-voyage__duo-card--bottom-right">
                <img
                  src={resolveAsset('/img/A7R01304.jpg')}
                  alt="Dr. Stefanie Schinnerl: Business, Leadership und Klarheit"
                  class="ql-about-voyage__duo-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
