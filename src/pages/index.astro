          <div class="ql-about-voyage__photo-col ql-stagger">
            <div class="ql-about-voyage__moodboard ql-about-voyage__moodboard--duo">
              {/* Foto 1: Oben Links (0795 - Gemeinschaft, Energie & Lachen) */}
