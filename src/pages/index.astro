---
import Layout from '../layouts/Layout.astro';
import LookbookGallery from '../components/LookbookGallery.astro';

const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const resolveAsset = (path: string) => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `${cleanBase}${cleanPath}`;
};
---

<Layout
  title="Holistic Mentoring & Health Coaching | Dr. Stefanie Schinnerl"
  description="Dr. Stefanie Schinnerl: Holistic Mentoring, Health Coaching & Keynote Speaking für ambitionierte Frauen. Business, Body & Mind."
>
  <main>
    {/* ① HERO SECTION */}
    <section class="ql-hero" id="home">
      <div class="ql-hero__bg-visual">
        <div class="ql-hero__fade-mask">
          <img
            src={resolveAsset('/img/A7R01339.jpg')}
            alt="Dr. Stefanie Schinnerl: Holistic Mentoring & Health Coaching"
            class="ql-hero__faded-img"
            loading="eager"
            decoding="async"
          />
          <div class="ql-hero__soft-overlay"></div>
        </div>
      </div>

      <div class="ql-hero__container">
        <div class="ql-hero__content-box">
          <span class="ql-hero__kicker">
            HOLISTIC MENTORING &amp; HEALTH COACHING
          </span>
          <h1 class="ql-hero__headline">
            Erfolg neu definieren.<br /><span class="ql-hero__headline-sub">Mit innerer Stärke und echter Vitalität.</span>
          </h1>
          <p class="ql-hero__text">
            Du trägst viel Verantwortung und verfolgst ambitionierte Ziele? Ich begleite Frauen dabei, ihr Leben mit Vitalität, Gesundheit und innerer Gelassenheit zu gestalten.
          </p>
          <div class="ql-hero__cta-group">
            <a href="#kontakt" class="ql-btn ql-btn--primary">
              Erstgespräch vereinbaren
            </a>
            <a href="#angebote" class="ql-btn ql-btn--outline">
              Angebote entdecken
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ② MEIN ANSATZ: Storytelling */}
    <section class="ql-ansatz ql-reveal" id="mein-ansatz">
      <div class="ql-ansatz__container">
        <div class="ql-ansatz__editorial">
          <div class="ql-ansatz__text-col">
            <span class="ql-kicker">MEIN ANSATZ</span>
            <h2 class="ql-headline">
              Ganzheitlich gedacht.<br />Für dein starkes Fundament.
            </h2>
            <p class="ql-ansatz__p">
              Fragst du dich manchmal, wo du selbst bei all den Terminen, Verpflichtungen und Erwartungen bleibst? Wünschst du dir Klarheit, wie du deinen anspruchsvollen Alltag meisterst, ohne deine Gesundheit, deine innere Ruhe und dein Wohlbefinden hintanzustellen?
            </p>
            <p class="ql-ansatz__p">
              Genau dafür habe ich <em>Business, Body &amp; Mind</em> geschaffen. Ein Ort für Frauen wie dich, die viel Verantwortung tragen und Leistungsfähigkeit mit Wohlbefinden verbinden wollen. Dabei geht es nicht um bloßes Funktionieren, sondern um echte innere Stärke und Vitalität.
            </p>
            <p class="ql-ansatz__p">
              Meine Methoden basieren auf sport- und gesundheitswissenschaftlichen Erkenntnissen und verbinden gezielte Bewegung mit wirksamem Resilienztraining. Gemeinsam entwickeln wir alltagstaugliche Systeme, die deinen Körper stärken, deinen Geist beruhigen und dir die Energie zurückgeben, die du für alles brauchst, was dir wichtig ist.
            </p>
            <p class="ql-ansatz__closing">
              Lass uns gemeinsam herausfinden, wie dieser Weg für dich aussehen kann.
            </p>
            <div class="ql-ansatz__cta">
              <a href="#kontakt" class="ql-btn ql-btn--primary">
                Erstgespräch vereinbaren
              </a>
            </div>
          </div>

          <div class="ql-ansatz__media-col">
            <div class="ql-ansatz__photo-wrap">
              <div class="ql-ansatz__photo-frame">
                <img
                  src={resolveAsset('/img/A7R00276.jpg')}
                  alt="Dr. Stefanie Schinnerl: Business, Body & Mind"
                  class="ql-ansatz__photo-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ATMOSPHERIC BANNER (1) */}
