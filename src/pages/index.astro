---
import Layout from '../layouts/Layout.astro';
import LookbookGallery from '../components/LookbookGallery.astro';

const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const resolveAsset = (path: string) => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `${cleanBase}${cleanPath}`;
};
---

<Layout
  title="Holistic Mentoring & Health Coaching | Dr. Stefanie Schinnerl"
  description="Dr. Stefanie Schinnerl: Holistic Mentoring, Health Coaching & Keynote Speaking für ambitionierte Frauen. Business, Body & Mind."
>
  <main>
    {/* ① HERO SECTION */}
    <section class="ql-hero" id="home">
      <div class="ql-hero__bg-visual">
        <div class="ql-hero__fade-mask">
          <img
            src={resolveAsset('/img/A7R01339.jpg')}
            alt="Dr. Stefanie Schinnerl: Holistic Mentoring & Health Coaching"
            class="ql-hero__faded-img"
            loading="eager"
            decoding="async"
          />
          <div class="ql-hero__soft-overlay"></div>
        </div>
      </div>

      <div class="ql-hero__container">
        <div class="ql-hero__content-box">
          <span class="ql-hero__kicker">
            HOLISTIC MENTORING &amp; HEALTH COACHING
          </span>
          <h1 class="ql-hero__headline">
            Erfolg neu definieren.<br />Mit innerer Stärke und echter Vitalität.
          </h1>
          <p class="ql-hero__text">
            Ganzheitliches Mentoring &amp; Health Coaching für Frauen, die ihr Wohlbefinden, innere Ruhe und echte Vitalität wieder in den Mittelpunkt ihres Lebens stellen möchten.
          </p>
          <div class="ql-hero__cta-group">
            <a href="#kontakt" class="ql-btn ql-btn--primary">
              Erstgespräch vereinbaren
            </a>
            <a href="#angebote" class="ql-btn ql-btn--outline">
              Angebote entdecken
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ② MEIN ANSATZ: Storytelling */}
    <section class="ql-ansatz ql-reveal" id="mein-ansatz">
      <div class="ql-ansatz__container">
        <div class="ql-ansatz__editorial">
          <div class="ql-ansatz__text-col">
            <span class="ql-kicker">MEIN ANSATZ</span>
            <h2 class="ql-headline">
              Ganzheitlich gedacht. Für dein starkes Fundament.
            </h2>
            <p class="ql-ansatz__p">
              Fragst du dich manchmal, wo du selbst bei all den Terminen, Verpflichtungen und Erwartungen bleibst? Wünschst du dir Klarheit, wie du deinen anspruchsvollen Alltag meisterst, ohne deinen Körper, deine Nerven und dein Wohlbefinden hintanzustellen?
            </p>
            <p class="ql-ansatz__p">
              Genau dafür habe ich <em>Business, Body &amp; Mind</em> geschaffen. Ein Ort für Frauen, die viel Verantwortung tragen und ihr Leben neu ausrichten wollen: Nicht durch ständiges Überlasten und Funktionieren-Müssen, sondern getragen von innerer Stärke und echter Vitalität.
            </p>
            <p class="ql-ansatz__p">
              Mein Schwerpunkt liegt auf der gesundheitlichen und vitalen Ebene. Meine Methoden basieren auf sport- und gesundheitswissenschaftlichen Ansätzen, gezieltem Stressmanagement und Bewegung. Gemeinsam entwickeln wir alltagstaugliche Systeme, die deinen Körper stärken, deinen Geist beruhigen und dir die Energie zurückgeben, die du für alles brauchst, was dir wichtig ist.
            </p>
            <p class="ql-ansatz__closing">
              Schaffe dir den Raum für deine eigene Kraft.
            </p>
          </div>

          <div class="ql-ansatz__media-col">
            <div class="ql-ansatz__photo-wrap">
              <div class="ql-ansatz__handwritten-greeting">
                Schön, dass du da bist.
              </div>
              <div class="ql-ansatz__photo-frame">
                <img
                  src={resolveAsset('/img/A7R00276.jpg')}
                  alt="Dr. Stefanie Schinnerl: Business, Body & Mind"
                  class="ql-ansatz__photo-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ATMOSPHERIC BANNER (1) */}
