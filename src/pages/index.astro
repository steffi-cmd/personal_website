              <filter id="ql-shadow-lift">
                <feComponentTransfer>
                  <feFuncR type="gamma" exponent="0.62" amplitude="0.92" offset="0.05" />
                  <feFuncG type="gamma" exponent="0.62" amplitude="0.92" offset="0.05" />
