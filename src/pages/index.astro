      <div class="ql-atmospheric-banner__bg">
        <img
          src={resolveAsset('/img/A7R00690.jpg')}
          alt="Dr. Stefanie Schinnerl: Atmosphäre und Raum für Entfaltung"
          class="ql-atmospheric-banner__img"
