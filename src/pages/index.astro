  <script>
    function initExpertiseTabs() {
      const tabs = document.querySelectorAll('.ql-about-voyage__tab');
      const panels = document.querySelectorAll('.ql-about-voyage__tab-panel');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetIndex = tab.getAttribute('data-tab-index');
          
          tabs.forEach((t) => {
            t.classList.toggle('is-active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });

          panels.forEach((p) => {
            const isMatch = p.getAttribute('data-panel-index') === targetIndex;
            (p as HTMLElement).style.display = isMatch ? 'block' : 'none';
          });
        });
      });
    }

    function initContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!form || form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
      const statusDiv = document.getElementById('contact-status');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (statusDiv) {
          statusDiv.style.display = 'block';
          statusDiv.className = 'ql-contact__status ql-contact__status--info';
          statusDiv.textContent = 'Nachricht wird gesendet...';
        }

        const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.7';
          submitBtn.style.cursor = 'not-allowed';
          submitBtn.innerHTML = '<span>Wird gesendet...</span>';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          const result = await response.json();

          if (response.ok && result.success) {
            if (statusDiv) {
              statusDiv.className = 'ql-contact__status ql-contact__status--success';
              statusDiv.textContent = 'Vielen Dank für deine Nachricht! Ich habe deine Anfrage erhalten und melde mich so schnell wie möglich.';
            }
            form.reset();
          } else {
            throw new Error(result.message || 'Fehler beim Senden der Nachricht.');
          }
        } catch (error) {
          if (statusDiv) {
            statusDiv.className = 'ql-contact__status ql-contact__status--error';
            statusDiv.textContent = 'Es gab leider ein Problem beim Senden deiner Nachricht. Bitte versuche es erneut oder kontaktiere mich direkt per E-Mail.';
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
            submitBtn.innerHTML = originalBtnContent;
          }
        }
      });
    }

    initExpertiseTabs();
    initContactForm();
    document.addEventListener('astro:page-load', () => {
      initExpertiseTabs();
      initContactForm();
    });
  </script>
